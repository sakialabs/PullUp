# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# API local defaults. Compose overrides the database URL with PostgreSQL.
PULLUP_DATABASE_URL=sqlite+pysqlite:///./pullup.db
PULLUP_AUTO_CREATE_SCHEMA=true
PULLUP_SEED_SYNTHETIC=true

# Local Compose database only. Never reuse this password in a deployed environment.
POSTGRES_DB=pullup
POSTGRES_USER=pullup
POSTGRES_PASSWORD=pullup-local-only
